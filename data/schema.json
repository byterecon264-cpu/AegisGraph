{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AegisGraphScenario",
  "description": "Schema for synthetic cloud infrastructure and attack path scenarios",
  "type": "object",
  "required": ["scenario_id", "name", "description", "alert", "nodes", "edges"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "description": "Unique identifier for the scenario (e.g., leaked-key)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable scenario title"
    },
    "description": {
      "type": "string",
      "description": "Detailed narrative of the architecture and attack path"
    },
    "alert": {
      "type": "object",
      "required": ["id", "type", "severity", "target_node", "message"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "target_node": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "cloud_provider": { "type": "string" },
        "region": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "name": { "type": "string" },
          "data_class": { "type": "string", "enum": ["PII", "financial", "credential", "PHI", "internal", "public"] },
          "crown_jewel": { "type": "boolean" },
          "cves": {
            "type": "array",
            "items": { "type": "string" }
          },
          "compliance_violations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "properties": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "protocol": { "type": "string" },
          "port": { "type": "number" },
          "condition": { "type": "string" },
          "created_at": { "type": "string" },
          "properties": {
            "type": "object"
          }
        }
      }
    }
  }
}
